{
  "name": "hair-reviver-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB API for the Hair Reviver clinic CRM",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset",
    "test": "node --test --test-force-exit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
