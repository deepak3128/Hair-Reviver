# Hair Reviver backend environment

# Port the API listens on
PORT=4000

# MongoDB connection. LEAVE EMPTY to run on an in-memory MongoDB
# (no install needed). To use MongoDB Atlas, paste your connection string:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hair-reviver?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign login tokens. Change this in production.
JWT_SECRET=change-this-secret

# Demo day used for "overdue / due today / this month" calculations.
# Leave empty to use the real current date.
SIM_TODAY=

# In-memory MongoDB binary flavor (only used when MONGODB_URI is empty).
# Ubuntu-based distros (incl. Kali) need this so the right mongod is fetched.
MONGOMS_DISTRO=ubuntu2204

# Optional clinic-network gate: restrict Front Desk (staff) and Technician
# accounts to the clinic Wi-Fi / LAN by listing comma-separated CIDRs.
# Leave empty to allow any network (recommended for Render/Vercel).
# Owner / Admin is never restricted.
# CLINIC_NETWORKS=192.168.1.0/24

# Automatic WhatsApp reminders (WhatsApp Cloud API / Meta).
# Set both to actually auto-send reminders on the scheduler. Leave empty to
# keep the manual one-tap wa.me reminder buttons in the UI.
# HOW TO GET THESE: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# How often the reminder scheduler runs, in milliseconds (default 5 min).
REMINDER_INTERVAL_MS=300000
