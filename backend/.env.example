# Hair Reviver backend environment

# Port the API listens on
PORT=4000

# MongoDB connection. LEAVE EMPTY to run on an in-memory MongoDB
# (no install needed). To use MongoDB Atlas, paste your connection string:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hair-reviver?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign login tokens. Change this in production.
JWT_SECRET=change-this-secret

# Demo day used for "overdue / due today / this month" calculations.
# Leave empty to use the real current date.
SIM_TODAY=

# In-memory MongoDB binary flavor (only used when MONGODB_URI is empty).
# Ubuntu-based distros (incl. Kali) need this so the right mongod is fetched.
MONGOMS_DISTRO=ubuntu2204
